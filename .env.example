# ─── Приложение ───────────────────────────────────────────────────────────
PROJECT_NAME="Max Hackathon API"
# DEBUG включает echo SQL-запросов и create_all на старте.
# Схему создаёт Alembic — держите False везде, кроме локальных экспериментов.
DEBUG=False
API_V1_STR="/api/v1"
HOST=0.0.0.0
PORT=8000
# Порт, на котором docker compose публикует mini app
MINIAPP_PORT=8080

# Origins, которым разрешён доступ к API из браузера.
# В docker compose mini app ходит через nginx-прокси на свой же origin,
# поэтому CORS не нужен вовсе. Укажите реальный адрес при отдельном хостинге.
CORS_ORIGINS=*

# ─── PostgreSQL ───────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=hackaton_db

DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/hackaton_db
SYNC_DATABASE_URL=postgresql://postgres:postgres@db:5432/hackaton_db

# ─── Аутентификация ───────────────────────────────────────────────────────
# Токен бота у @MasterBot в MAX (https://dev.max.ru/docs).
# Им же проверяется подпись WebApp.initData, который присылает mini app.
MAX_BOT_TOKEN=

# Общий секрет для вызовов «сервис → сервис»: бот не может подписать initData,
# поэтому ходит в API с заголовками X-Service-Token + X-Max-User-Id.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_TOKEN=

# False разрешает опознавать себя простым заголовком X-Max-User-Id без подписи
# (удобно для Swagger и curl). В проде — только True.
REQUIRE_SIGNED_INIT_DATA=True
# Сколько секунд живёт подписанный initData
INIT_DATA_MAX_AGE=86400

# ─── ИИ-слой (OpenRouter): классификатор сферы и ИИ-консультант ──────────
# Ключ: https://openrouter.ai/settings/keys. Пусто — /classify работает
# по ключевым словам, а консультант — поиском по каталогу. У :free моделей жёсткие лимиты запросов.
# Модели через запятую: первая основная, остальные — запасные.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free,nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_TIMEOUT=6
# Бюджет ИИ-консультанта в боте (с учётом ретраев при 429), секунды.
# Бот ждёт ответ до 40 с — держите значение меньше.
ASSISTANT_TIMEOUT=25

# ─── Бот ──────────────────────────────────────────────────────────────────
BACKEND_BASE_URL=http://web:8000/api/v1
USE_WEBHOOK=False
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
# Публичный HTTPS-адрес mini app — показывается в кнопке «Открыть приложение»
MINIAPP_URL=

# ─── Деплой (docker-compose.prod.yml) ─────────────────────────────────────
# Домен, на который Caddy выпускает HTTPS-сертификат
DOMAIN=
# Порт HTTPS; поменяйте, если 443 на сервере занят (например, VPN)
HTTPS_PORT=443
